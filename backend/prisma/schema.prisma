generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

model Product {
  id        Int     @id @default(autoincrement())
  name      String
  category  String  @default("General Grocery")
  price     Float
  stock     Int
  imageUrl  String?
  deletedAt DateTime?

  orderItems OrderItem[] 
   cartItems   CartItem[] 
}

model Order {
 id        Int      @id @default(autoincrement())
 customer  String
 phone     String
 address   String
 latitude  Float?
 longitude Float?

 total     Int
 orderStatus    String   @default("pending")

 items     OrderItem[]

 createdAt DateTime @default(now())
}

model OrderItem {
 id        Int @id @default(autoincrement())

 orderId   Int
 productId Int
 price  Decimal

 quantity  Int

 order     Order   @relation(fields: [orderId], references: [id])
 product   Product @relation(fields: [productId], references: [id])
}


model Admin {
    id  Int @id @default(autoincrement())
    email   String @unique
    password  String
}

model User {
    id Int @id @default(autoincrement())
    email String @unique
    password String 
    role String @default("Admin")
    picture String?
    createdAt DateTime @default(now())
}

model Cart {
   id Int @id @default(autoincrement())

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
 id Int @id @default(autoincrement())

  cartId    Int
  productId Int

  quantity  Int

  cart      Cart     @relation(fields: [cartId], references: [id])

  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}
