generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  stock             Int
  price             Decimal     @db.Decimal(10, 2)
  unit              String      @default("per piece")
  imageUrl          String?
  deletedAt         DateTime?
  category          String      @default("General Grocery")
  lowStockThreshold Int         @default(10)
  cartItems         CartItem[]
  orderItems        OrderItem[]
}

model Order {
  id            Int         @id @default(autoincrement())
  customer      String
  phone         String
  address       String
  total         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  latitude      Float?
  longitude     Float?
  orderStatus   String      @default("pending")
  city          String?
  postalCode    String?
  street        String?
  userId        Int?
  paymentStatus String      @default("pending")
  paymentMethod String      @default("mpesa")
  user          User?       @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                  Int       @id @default(autoincrement())
  orderId             Int       @unique
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("KES")
  paymentMethod       String    @default("mpesa")
  merchantRequestId   String?
  checkoutRequestId   String?   @unique
  responseCode        String?
  responseDescription String?
  customerMessage     String?
  status              String    @default("pending")
  mpesaReceiptNumber  String?
  resultCode          String?
  resultDescription   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  completedAt         DateTime?
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([checkoutRequestId])
  @@index([orderId])
  @@index([status])
}

model AdminSetting {
  id                   Int      @id @default(1)
  workspaceName        String   @default("Corner Store")
  defaultCurrency      String   @default("KES")
  notificationsEnabled Boolean  @default(true)
  timezone             String   @default("Africa/Nairobi")
  language             String   @default("en")
  lowStockThreshold    Int      @default(10)
  orderAutoCancelHours Int      @default(24)
  deliveryFee          Float    @default(0)
  supportEmail         String   @default("")
  supportPhone         String   @default("")
  taxRate              Float    @default(16)
  minOrderAmount       Float    @default(0)
  freeDeliveryThreshold Float   @default(0)
  deliveryTimeWindow   String   @default("")
  deliveryRadiusKm     Int      @default(20)
  mpesaEnabled         Boolean  @default(true)
  codEnabled           Boolean  @default(true)
  allowRegistration    Boolean  @default(true)
  hideOutOfStock       Boolean  @default(false)
  storeTagline         String   @default("")
  announcementBanner   String   @default("")
  storeOpen            Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  picture   String?
  createdAt DateTime @default(now())
  cart      Cart?
  orders    Order[]
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model Cart {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    Int?       @unique
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}
